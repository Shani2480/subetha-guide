<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <!-- ==== Global theme & layout ==== -->
    <group name="General">
        <!-- auto: movie pages while the sun is up at the weather location, CRT terminal after sunset -->
        <entry name="themeMode" type="String">
            <default>auto</default>
        </entry>
        <!-- legacy global mode, superseded by the per-section densities below;
             "minimal" is migrated to all-compact once on load, then reset -->
        <entry name="displayMode" type="String">
            <default>full</default>
        </entry>
        <!-- per section: "full" (drawers, graphs, characters) or "compact" (slim pills) -->
        <entry name="weatherDensity" type="String">
            <default>full</default>
        </entry>
        <entry name="systemDensity" type="String">
            <default>compact</default>
        </entry>
        <entry name="diskDensity" type="String">
            <default>compact</default>
        </entry>
        <entry name="batteryDensity" type="String">
            <default>compact</default>
        </entry>
        <!-- ==== panel item ==== -->
        <!-- weather cpuTemp gpuTemp cpuLoad ramUsage netSpeed battery multiPill -->
        <entry name="panelDisplaySensor" type="String">
            <default>weather</default>
        </entry>
        <entry name="showPanelIcon" type="Bool">
            <default>true</default>
        </entry>
        <entry name="showPanelMeter" type="Bool">
            <default>true</default>
        </entry>
        <!-- 0: static; otherwise step through the available readings every N seconds -->
        <entry name="panelCycleInterval" type="Int">
            <default>0</default>
            <min>0</min>
            <max>600</max>
        </entry>
        <!-- order is fixed (weather, system, disk, battery); this only switches sections on and off -->
        <entry name="enabledSections" type="StringList">
            <default>weather,system,disk,battery</default>
        </entry>
    </group>

    <!-- ==== Weather ==== -->
    <group name="Weather">
        <entry name="latitude" type="Double">
            <default>51.6256</default>
        </entry>
        <entry name="longitude" type="Double">
            <default>4.9389</default>
        </entry>
        <entry name="locationName" type="String">
            <default>Dongen</default>
        </entry>
        <entry name="showWeatherCharacter" type="Bool">
            <default>true</default>
        </entry>
        <entry name="enableBackgroundAnimations" type="Bool">
            <default>true</default>
        </entry>
        <entry name="iconStyle" type="String">
            <default>wireframe</default>
        </entry>
        <entry name="temperatureUnit" type="String">
            <default>celsius</default>
        </entry>
        <entry name="windSpeedUnit" type="String">
            <default>kmh</default>
        </entry>
        <entry name="updateIntervalMinutes" type="Int">
            <default>15</default>
            <min>5</min>
            <max>180</max>
        </entry>
        <entry name="translucentDesktopBackground" type="Bool">
            <default>true</default>
        </entry>
    </group>

    <!-- ==== System monitor ==== -->
    <group name="System">
        <entry name="showTelemetryGraphs" type="Bool">
            <default>true</default>
        </entry>
        <entry name="showSystemSpecs" type="Bool">
            <default>true</default>
        </entry>
        <entry name="showFanSpeeds" type="Bool">
            <default>true</default>
        </entry>
        <!-- "auto" (the first GPU ksystemstats lists) or its id, e.g. "gpu1" -->
        <entry name="gpuDevice" type="String">
            <default>auto</default>
        </entry>
        <entry name="systemUpdateInterval" type="Int">
            <default>2000</default>
            <min>500</min>
            <max>10000</max>
        </entry>
        <!-- fans follow showFanSpeeds; these are the other pills -->
        <entry name="visibleSensors" type="StringList">
            <default>cpu,ram,net,gpu</default>
        </entry>
        <entry name="tempUnit" type="String">
            <default>C</default>
        </entry>
        <entry name="showFanPercent" type="Bool">
            <default>false</default>
        </entry>
        <!-- per pill, "small" (one line and a slim meter) or "large" (graphs and
             sub-metrics); flipped by the [ - ] / [ + ] tag on the pill. Only
             counts while the System section itself is full. -->
        <entry name="cpuSensorSize" type="String">
            <default>large</default>
        </entry>
        <entry name="ramSensorSize" type="String">
            <default>small</default>
        </entry>
        <entry name="gpuSensorSize" type="String">
            <default>large</default>
        </entry>
        <entry name="netSensorSize" type="String">
            <default>large</default>
        </entry>
        <entry name="fanSensorSize" type="String">
            <default>small</default>
        </entry>
        <!-- temperature colours on the CPU / GPU bars, as % of the 30-100 °C scale:
             warn turns the wash orange, critical turns it red, pulsing, with a pulsing border -->
        <entry name="tempColorAlerts" type="Bool">
            <default>true</default>
        </entry>
        <entry name="tempWarnPercent" type="Int">
            <default>80</default>
            <min>50</min>
            <max>99</max>
        </entry>
        <entry name="tempCriticalPercent" type="Int">
            <default>90</default>
            <min>50</min>
            <max>100</max>
        </entry>
        <entry name="fanMaxRpm" type="Int">
            <default>6000</default>
            <min>1000</min>
            <max>20000</max>
        </entry>
    </group>

    <!-- ==== Disks ==== -->
    <group name="Disk">
        <entry name="selectedMountPoints" type="StringList">
            <default>/</default>
        </entry>
        <entry name="showIoThroughput" type="Bool">
            <default>true</default>
        </entry>
        <!-- auto GB TB percent -->
        <entry name="storageUnit" type="String">
            <default>auto</default>
        </entry>
        <!-- free used both -->
        <entry name="valueFormat" type="String">
            <default>free</default>
        </entry>
        <entry name="hideRemovableDisks" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showBootPartitions" type="Bool">
            <default>false</default>
        </entry>
        <entry name="warningThreshold" type="Int">
            <default>90</default>
            <min>50</min>
            <max>99</max>
        </entry>
    </group>

    <!-- ==== Battery ==== -->
    <group name="Battery">
        <!-- "all", "primary", or device keys (kind:NAME) -->
        <entry name="selectedBatteryDevices" type="StringList">
            <default>all</default>
        </entry>
        <entry name="showPowerRate" type="Bool">
            <default>true</default>
        </entry>
        <entry name="showPercentageOnly" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showChargingEstimate" type="Bool">
            <default>true</default>
        </entry>
        <!-- below alertThreshold: blink the percentage and DEPLETION IMMINENT, like the disk warning -->
        <entry name="batteryBlink" type="Bool">
            <default>true</default>
        </entry>
        <entry name="alertThreshold" type="Int">
            <default>15</default>
            <min>1</min>
            <max>50</max>
        </entry>
    </group>
</kcfg>
