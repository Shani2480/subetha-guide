{
  "id": "h2g2",
  "name": "The Hitchhiker's Guide (Sub-Etha)",
  "author": "Shani",
  "version": "2.0.0",
  "builtin": true,
  "description": "The Guide's own look: 1981 phosphor CRT after dark, the 2005 movie's cream pages by day. Built into both apps.",
  "fontFamily": "monospace",
  "features": {
    "enableCrtScanlines": true,
    "enablePhosphorDecay": true,
    "enableCornerBrackets": true,
    "enableGlassBlur": false,
    "enableGrid": true
  },
  "geometry": {
    "cardShape": "rounded",
    "pillShape": "stadium",
    "gaugeShape": "segmented",
    "cornerRadius": 14,
    "borderStyle": "solid",
    "borderWidth": 1,
    "hasCornerBrackets": true,
    "shadowType": "glow"
  },
  "variants": {
    "dark": {
      "background": "#040806",
      "cardBackground": "#07110C",
      "cardBackgroundHover": "#0B1A12",
      "textPrimary": "#00FF66",
      "textSecondary": "#00B347",
      "accent": "#FFB000",
      "accentSecondary": "#FF3333",
      "border": "#00FF66",
      "gaugeTrack": "#0F2A1A",
      "gaugeUsage": "#00FF66",
      "gaugeTemp": "#FFB000",
      "badgeBackground": "#FFB000",
      "badgeText": "#040806"
    },
    "light": {
      "background": "#F5F2EB",
      "cardBackground": "#EDE8DC",
      "cardBackgroundHover": "#F8F5EE",
      "textPrimary": "#1B2028",
      "textSecondary": "#4A5260",
      "accent": "#FFBE1A",
      "accentSecondary": "#FF6B4A",
      "border": "#1B2028",
      "gaugeTrack": "#D9D2C2",
      "gaugeUsage": "#26A69A",
      "gaugeTemp": "#FFBE1A",
      "badgeBackground": "#FF6B4A",
      "badgeText": "#FFFFFF"
    }
  },
  "narrative": {
    "badgeLabel": "DON'T PANIC",
    "weatherSkyHazard": "whale",
    "weatherSkyHazardSecondary": "petunias",
    "roamerPrimary": "arthur-bathrobe",
    "roamerSecondary": "marvin",
    "quips": {
      "nominal": "MOSTLY HARMLESS. THE MACHINE IS CONTEMPLATING THE ANSWER.",
      "critical": "WARNING: TEMPERATURES APPROACHING THOSE OF A SMALL SUN. DON'T PANIC."
    }
  }
}
