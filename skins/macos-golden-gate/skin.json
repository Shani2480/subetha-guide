{
  "id": "macos-golden-gate",
  "name": "macOS Golden Gate (System Hub)",
  "author": "Shani",
  "version": "2.1.0",
  "description": "Smoked frosted glass over Marin Headlands dusk, or Presidio daylight: International Orange and golden-hour amber, capsule meters, soft graphs and a suspension bridge on the horizon.",
  "fontFamily": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro Display', sans-serif",
  "features": {
    "enableCrtScanlines": false,
    "enablePhosphorDecay": false,
    "enableCornerBrackets": false,
    "enableGlassBlur": true,
    "enableGrid": false,
    "enableBarrel": false
  },
  "geometry": {
    "cardShape": "rounded",
    "pillShape": "stadium",
    "gaugeShape": "stadium",
    "cornerRadius": 18,
    "borderStyle": "solid",
    "borderWidth": 1.0,
    "hasCornerBrackets": false,
    "hasDropShadow": true,
    "shadowType": "soft",
    "shadowOffset": [
      0,
      8
    ],
    "shadowBlur": 24
  },
  "chrome": {
    "style": "aqua",
    "buttons": "traffic",
    "titleAlign": "center",
    "topRadius": 18,
    "bottomRadius": 18,
    "frameWidth": 1,
    "logo": "assets/golden_gate_icon.svg"
  },
  "sections": {
    "style": "card",
    "uppercase": true
  },
  "controls": {
    "graph": "line",
    "graphFill": true,
    "meterLabel": false
  },
  "icons": {
    "app": "assets/golden_gate_icon.svg",
    "weather": "assets/sun_golden_hour.svg"
  },
