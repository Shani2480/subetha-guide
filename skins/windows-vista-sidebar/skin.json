{
  "id": "windows-vista-sidebar",
  "name": "Windows Vista (Sidebar Gadgets)",
  "author": "Shani",
  "version": "2.1.0",
  "description": "Sidebar gadgets on Aero glass: a curved gloss over each panel, chrome-rimmed analog dials with glowing needles, an oscilloscope CPU graph and glassy green LED memory bars.",
  "fontFamily": "Segoe UI, Tahoma, Arial, sans-serif",
  "features": {
    "enableCrtScanlines": false,
    "enablePhosphorDecay": false,
    "enableCornerBrackets": false,
    "enableGlassBlur": true,
    "enableGrid": false,
    "enableBarrel": false
  },
  "geometry": {
    "cardShape": "rounded",
    "pillShape": "rounded",
    "gaugeShape": "analog-dial",
    "cornerRadius": 10,
    "borderStyle": "solid",
    "borderWidth": 1.5,
    "hasCornerBrackets": false,
    "hasDropShadow": true,
    "shadowType": "soft",
    "shadowOffset": [
      0,
      6
    ],
    "shadowBlur": 18
  },
  "chrome": {
    "style": "aero",
    "buttons": "aero",
    "titleAlign": "left",
    "topRadius": 10,
    "bottomRadius": 10,
    "frameWidth": 1,
    "logo": "assets/vista_aero_orb.svg",
    "titleTop": "rgba(40, 90, 110, 0.80)",
    "titleBottom": "rgba(10, 30, 45, 0.80)",
    "titleText": "#FFFFFF",
    "titleShadow": "rgba(0, 0, 0, 0.7)",
    "frameColor": "rgba(180, 225, 255, 0.35)",
    "buttonFace": "rgba(255, 255, 255, 0.30)",
    "buttonGlyph": "#FFFFFF",
    "closeFace": "#C7372F",
    "closeGlyph": "#FFFFFF"
  },
  "sections": {
    "style": "gadget",
    "uppercase": true,
    "titleSize": 12,
    "gloss": 0.45,
    "gear": "assets/settings_gear.svg",
    "close": "assets/close_btn_vista.svg",
    "bandText": "#FFFFFF"
  },
  "controls": {
    "meter": "bevel",
    "meterLabel": true,
    "graph": "taskmgr",
    "graphFill": false,
    "dialRim": "assets/dial_chrome_rim.svg",
    "dialTempMax": 80,
    "dialDangerFrom": 70
  },
  "icons": {
    "app": "assets/icons/app.svg",
    "cpu": "assets/icons/cpu.svg",
    "ram": "assets/icons/ram.svg",
    "swap": "assets/icons/swap.svg",
    "gpu": "assets/icons/gpu.svg",
    "netDown": "assets/icons/netDown.svg",
    "netUp": "assets/icons/netUp.svg",
    "disk": "assets/icons/disk.svg",
    "battery": "assets/icons/battery.svg",
    "fan": "assets/icons/fan.svg",
    "clock": "assets/icons/clock.svg",
    "process": "assets/icons/process.svg",
    "service": "assets/icons/service.svg",
    "settings": "assets/icons/settings.svg",
    "ai": "assets/icons/ai.svg",
    "weather": "assets/icons/weather.svg"
  },
