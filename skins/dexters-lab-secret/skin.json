{
  "id": "dexters-lab-secret",
  "name": "Dexter's Lab (Secret Lab HUD)",
  "author": "Shani",
  "version": "2.1.0",
  "description": "A 90s cartoon lab terminal: heavy ink outlines, a top-left chamfer, angled cyan header tabs, neon chemical capsules and the lab bot over a suburb with a secret bunker beneath it.",
  "fontFamily": "Impact, 'Arial Black', 'Anton', 'Trebuchet MS', 'Comic Neue', sans-serif",
  "features": {
    "enableCrtScanlines": false,
    "enablePhosphorDecay": false,
    "enableCornerBrackets": false,
    "enableGlassBlur": false,
    "enableCartoonOutlines": true,
    "enableGrid": false
  },
  "geometry": {
    "cardShape": "chamfer",
    "pillShape": "stadium",
    "gaugeShape": "stadium",
    "chamferCut": 12,
    "chamferCorners": [
      "tl"
    ],
    "cornerRadius": 8,
    "borderStyle": "solid",
    "borderWidth": 2.5,
    "hasCornerBrackets": false,
    "hasDropShadow": true,
    "shadowType": "flat-2d",
    "shadowOffset": [
      3,
      3
    ],
    "shadowBlur": 0
  },
  "chrome": {
    "style": "plain",
    "titleAlign": "left",
    "logo": "assets/magenta_atom.svg"
  },
  "sections": {
    "style": "flagtab",
    "numbered": true,
    "uppercase": true,
    "toggle": "box",
    "flagMark": "assets/magenta_atom.svg"
  },
  "controls": {
    "graph": "line",
    "graphFill": true,
    "meterColors": {
      "cpu": "#00E5FF",
      "memory": "#00E5FF",
      "swap": "#00E5FF",
      "disk": "#00E5FF",
      "gpu": "#FF1493",
      "battery": "#39FF14"
    }
  },
  "icons": {
    "app": "assets/icons/app.svg",
    "cpu": "assets/icons/cpu.svg",
    "ram": "assets/icons/ram.svg",
    "swap": "assets/icons/swap.svg",
    "gpu": "assets/icons/gpu.svg",
    "netDown": "assets/icons/netDown.svg",
    "netUp": "assets/icons/netUp.svg",
    "disk": "assets/icons/disk.svg",
    "battery": "assets/icons/battery.svg",
    "fan": "assets/icons/fan.svg",
    "clock": "assets/icons/clock.svg",
    "ai": "assets/icons/ai.svg",
    "process": "assets/icons/process.svg",
    "service": "assets/icons/service.svg",
    "settings": "assets/icons/settings.svg",
    "weather": "assets/moon_star_cartoon.svg"
  },
  "art": {
    "weather": "assets/lab_scene_night.svg"
  },
  "footer": {
    "mark": "assets/dexters_lab_logo.svg",
    "label": "SECRET LAB",
    "motto": "LEVEL-10 // AUTHORIZED PERSONNEL ONLY",
    "endMark": "assets/magenta_atom.svg"
  },
  "variants": {
    "dark": {
      "variantName": "Midnight Laboratory (Night)",
      "background": "#0A1118",
      "cardBackground": "#0F1A24",
      "cardBackgroundHover": "#162533",
      "textPrimary": "#FFFFFF",
      "textSecondary": "#7FA3BA",
      "accent": "#00E5FF",
      "accentSecondary": "#FF1493",
      "accentTertiary": "#39FF14",
      "border": "#00E5FF",
