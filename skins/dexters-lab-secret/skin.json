      "gaugeTrack": "rgba(0, 229, 255, 0.15)",
      "gaugeUsage": "#00E5FF",
      "gaugeTemp": "#FF1493",
      "badgeBackground": "#00E5FF",
      "badgeText": "#0A1118",
