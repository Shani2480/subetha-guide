{
  "id": "dexters-lab-console",
  "name": "Dexter's Lab (System Console)",
  "author": "Shani",
  "version": "2.1.0",
  "description": "A cartoon lab supercomputer: bubbling vacuum tubes, a klaxon that wails at critical load, switch-covered side pillars, wedge dials, an oscilloscope and a thermometer on the weather screen, all in thick ink outlines.",
  "fontFamily": "Impact, Arial Black, Anton, Trebuchet MS, sans-serif",
  "fonts": [
    "assets/fonts/Anton-Regular.ttf"
  ],
  "features": {
    "enableCrtScanlines": false,
    "enablePhosphorDecay": false,
    "enableCornerBrackets": false,
    "enableGlassBlur": false,
    "enableGrid": false,
    "enableBarrel": false,
    "enableCartoonOutlines": true
  },
  "geometry": {
    "cardShape": "rounded",
    "pillShape": "stadium",
    "gaugeShape": "analog-dial",
    "cornerRadius": 22,
    "borderStyle": "solid",
    "borderWidth": 3.0,
    "hasCornerBrackets": false,
    "hasDropShadow": true,
    "shadowType": "flat-2d",
    "shadowOffset": [
      4,
      4
    ],
    "shadowBlur": 0
  },
  "frame": {
    "style": "console",
    "tubes": "assets/vacuum_tubes.svg",
    "siren": "assets/red_alarm_siren.svg",
    "plaqueTitle": "LAB CONSOLE",
    "plaqueSubtitle": "SYSTEM CONSOLE",
    "pillars": true,
    "rail": true,
    "plaque": "#16304A",
    "plaqueText": "#FFFF33",
    "plaqueSubtext": "#85D7FF"
  },
  "sections": {
    "style": "card",
    "uppercase": true,
    "screws": true
  },
  "controls": {
    "meter": "",
    "meterLabel": true,
    "graph": "taskmgr",
    "graphFill": false,
    "dialStyle": "semicircle",
    "thermometer": true,
    "dialTempMax": 100,
    "dialDangerFrom": 80
  },
  "icons": {
    "app": "assets/icons/app.svg",
    "cpu": "assets/icons/cpu.svg",
    "ram": "assets/icons/ram.svg",
    "swap": "assets/icons/swap.svg",
    "gpu": "assets/icons/gpu.svg",
    "netDown": "assets/icons/netDown.svg",
    "netUp": "assets/icons/netUp.svg",
    "disk": "assets/icons/disk.svg",
    "battery": "assets/icons/battery.svg",
    "fan": "assets/icons/fan.svg",
    "clock": "assets/icons/clock.svg",
    "process": "assets/icons/process.svg",
    "service": "assets/icons/service.svg",
    "settings": "assets/icons/settings.svg",
    "ai": "assets/icons/ai.svg",
    "weather": "assets/icons/weather.svg"
  },
  "art": {
    "gpu": "assets/cartoon_gpu_board.svg",
    "weather": "assets/weather_suburbia_storm.svg",
    "cpu": "assets/dexter_thinking_face.svg"
  },
