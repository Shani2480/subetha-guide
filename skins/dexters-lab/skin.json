      "idleFrame": "assets/dexter_idle.svg",
      "alertFrame": "assets/dexter_panic.svg",
      "width": 20,
      "height": 27,
      "stride": 6,
      "bob": true
    },
    {
      "name": "Dee Dee",
      "frames": ["assets/deedee_dance_01.svg", "assets/deedee_dance_02.svg"],
      "alertFrame": "assets/deedee_reach.svg",
      "width": 21,
      "height": 33,
