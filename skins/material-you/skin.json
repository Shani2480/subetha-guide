{
  "id": "material-you",
  "name": "Material You (M3 Expressive)",
  "author": "Shani",
  "version": "2.1.0",
  "description": "Material 3 Expressive: tonal surface containers, 24px rounded cards, stadium pills and capsule gauges on soft elevation, in Monet lavender light and dark.",
  "fontFamily": "Google Sans, Roboto Flex, sans-serif",
  "features": {
    "enableCrtScanlines": false,
    "enablePhosphorDecay": false,
    "enableCornerBrackets": false,
    "enableGlassBlur": false,
    "enableGrid": false
  },
  "geometry": {
    "cardShape": "rounded",
    "pillShape": "stadium",
    "gaugeShape": "wavy",
    "cornerRadius": 24,
    "borderStyle": "solid",
    "borderWidth": 0,
    "hasCornerBrackets": false,
    "hasDropShadow": true,
    "shadowType": "soft",
    "shadowOffset": [
      0,
      6
    ],
    "shadowBlur": 16
  },
  "chrome": {
    "style": "material",
    "buttons": "material",
    "titleAlign": "left",
    "topRadius": 24,
    "bottomRadius": 24,
    "frameWidth": 0
  },
  "controls": {
    "graph": "line",
    "graphFill": true
  },
  "icons": {
    "app": "assets/icons/app.svg",
    "cpu": "assets/icons/cpu.svg",
    "ram": "assets/icons/ram.svg",
    "swap": "assets/icons/swap.svg",
    "gpu": "assets/icons/gpu.svg",
    "netDown": "assets/icons/netDown.svg",
    "netUp": "assets/icons/netUp.svg",
    "disk": "assets/icons/disk.svg",
    "battery": "assets/icons/battery.svg",
    "fan": "assets/icons/fan.svg",
    "clock": "assets/icons/clock.svg",
    "process": "assets/icons/process.svg",
    "service": "assets/icons/service.svg",
    "settings": "assets/icons/settings.svg",
    "ai": "assets/icons/ai.svg",
    "weather": "assets/icons/weather.svg"
  },
  "variants": {
