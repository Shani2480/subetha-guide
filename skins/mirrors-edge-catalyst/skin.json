{
  "id": "mirrors-edge-catalyst",
  "name": "Mirror's Edge Catalyst (OS 2.0)",
  "author": "Shani",
  "version": "2.1.0",
  "description": "A runner's tactical HUD over the City of Glass: 45° chamfered cards in a hairline Runner Red, an isometric CPU socket and GPU die, a wireframe skyline at dusk or high noon.",
  "fontFamily": "Ubuntu, Segoe UI, -apple-system, sans-serif",
  "fonts": [
    "assets/fonts/Ubuntu-Regular.ttf",
    "assets/fonts/Ubuntu-Bold.ttf"
  ],
  "features": {
    "enableCrtScanlines": false,
    "enablePhosphorDecay": false,
    "enableCornerBrackets": true,
    "enableGlassBlur": true,
    "enableGrid": false,
    "enableBarrel": false
  },
  "geometry": {
    "cardShape": "chamfer",
    "pillShape": "chamfer",
    "gaugeShape": "chamfer",
    "chamferCut": 12,
    "pillChamferCut": 6,
    "cornerRadius": 0,
    "borderStyle": "solid",
    "borderWidth": 1.2,
    "hasCornerBrackets": true,
    "hasDropShadow": true,
    "shadowType": "soft",
    "shadowOffset": [
      0,
      6
    ],
    "shadowBlur": 20
  },
  "chrome": {
    "style": "hud",
    "buttons": "hud",
    "titleAlign": "left",
    "titleHeight": 40,
    "frameWidth": 1,
    "badge": "assets/me2_logo_badge.svg",
    "subtitle": "SYSTEM DIAGNOSTICS"
  },
  "sections": {
    "style": "card",
    "uppercase": true,
    "titleSize": 13
  },
  "controls": {
    "graph": "line",
    "graphFill": false,
    "meterLabel": false
  },
  "icons": {
    "app": "assets/icons/app.svg",
    "cpu": "assets/icons/cpu.svg",
    "ram": "assets/icons/ram.svg",
    "swap": "assets/icons/swap.svg",
    "gpu": "assets/icons/gpu.svg",
    "netDown": "assets/icons/netDown.svg",
    "netUp": "assets/icons/netUp.svg",
    "disk": "assets/icons/disk.svg",
    "battery": "assets/icons/battery.svg",
    "fan": "assets/icons/fan.svg",
    "clock": "assets/icons/clock.svg",
    "process": "assets/icons/process.svg",
    "service": "assets/icons/service.svg",
    "settings": "assets/icons/settings.svg",
    "ai": "assets/icons/ai.svg",
    "weather": "assets/icons/weather.svg"
  },
  "art": {
    "cpu": "assets/cpu_socket_icon.svg",
    "gpu": "assets/gpu_die_isometric.svg",
    "weather": "assets/city_glass_wireframe.svg"
  },
  "variants": {
