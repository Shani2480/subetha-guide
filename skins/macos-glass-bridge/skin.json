{
  "id": "macos-glass-bridge",
  "name": "macOS Glass (Golden Gate)",
  "author": "Shani",
  "version": "2.1.0",
  "description": "Frosted acrylic squircles with traffic lights on every card, smooth International Orange capsules, and the bridge tower at Marin dusk or Presidio daylight.",
  "fontFamily": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro Display', 'Inter', sans-serif",
  "features": {
    "enableCrtScanlines": false,
    "enablePhosphorDecay": false,
    "enableCornerBrackets": false,
    "enableGlassBlur": true,
    "enableGrid": false
  },
  "geometry": {
    "cardShape": "rounded",
    "pillShape": "stadium",
    "gaugeShape": "stadium",
    "cornerRadius": 16,
    "borderStyle": "solid",
    "borderWidth": 1.0,
    "hasCornerBrackets": false,
    "hasDropShadow": true,
    "shadowType": "soft",
    "shadowOffset": [
      0,
      8
    ],
    "shadowBlur": 24
  },
  "chrome": {
    "style": "aqua",
    "buttons": "traffic",
    "titleAlign": "center",
    "topRadius": 16,
    "bottomRadius": 16,
    "frameWidth": 1,
    "titleBold": false,
    "logo": "assets/icons/app.svg"
  },
  "sections": {
    "style": "card",
    "numbered": true,
    "uppercase": false,
    "lights": "traffic",
    "titleSize": 12
  },
  "controls": {
    "graph": "line",
    "graphFill": true,
    "meterLabel": false
  },
  "icons": {
    "app": "assets/icons/app.svg",
    "cpu": "assets/icons/cpu.svg",
    "ram": "assets/icons/ram.svg",
    "swap": "assets/icons/swap.svg",
    "gpu": "assets/icons/gpu.svg",
    "netDown": "assets/icons/netDown.svg",
    "netUp": "assets/icons/netUp.svg",
    "disk": "assets/icons/disk.svg",
    "battery": "assets/icons/battery.svg",
    "fan": "assets/icons/fan.svg",
    "clock": "assets/icons/clock.svg",
    "ai": "assets/icons/ai.svg",
    "process": "assets/icons/process.svg",
    "service": "assets/icons/service.svg",
    "settings": "assets/icons/settings.svg",
    "weather": "assets/moon_star_icon.svg"
  },
  "art": {
    "weather": "assets/golden_gate_tower_dusk.svg",
    "disk": "assets/golden_gate_tower_dusk.svg"
  },
