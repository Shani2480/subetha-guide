{
  "id": "mirrors-edge-runner",
  "name": "Mirror's Edge (Runner Vision)",
  "author": "Shani",
  "version": "2.1.0",
  "description": "Runner Vision in two shifts: Infiltration at night (black glass, red edges) and the City of Glass by day (white and steel). Numbered red flag tabs, 45° cut corners and discrete red segment meters.",
  "fontFamily": "Ubuntu Mono, Roboto Mono, SF Pro Display, monospace",
  "fonts": [
    "assets/fonts/UbuntuMono-Regular.ttf",
    "assets/fonts/UbuntuMono-Bold.ttf"
  ],
  "features": {
    "enableCrtScanlines": false,
    "enablePhosphorDecay": false,
    "enableCornerBrackets": true,
    "enableGlassBlur": false,
    "enableGrid": false,
    "enableBarrel": false
  },
  "geometry": {
    "cardShape": "chamfer",
    "pillShape": "chamfer",
    "gaugeShape": "segmented",
    "chamferCut": 14,
    "pillChamferCut": 6,
    "chamferCorners": [
      "bl",
      "br"
    ],
    "segments": 16,
    "cornerRadius": 0,
    "borderStyle": "solid",
    "borderWidth": 1.5,
    "hasCornerBrackets": true,
    "hasDropShadow": false,
    "shadowType": "none",
    "shadowOffset": [
      0,
      0
    ],
    "shadowBlur": 0
  },
  "chrome": {
    "style": "hud",
    "buttons": "hud",
    "titleAlign": "left",
    "frameWidth": 1,
    "badge": "assets/me_runner_badge.svg",
    "subtitle": "RUNNER VISION"
  },
  "sections": {
    "style": "flagtab",
    "numbered": true,
    "uppercase": true,
    "flagMark": "assets/me_runner_mark_white.svg"
  },
  "controls": {
    "meter": "",
    "meterLabel": false,
    "graph": "line",
    "graphFill": false
  },
  "icons": {
    "app": "assets/icons/app.svg",
    "cpu": "assets/icons/cpu.svg",
    "ram": "assets/icons/ram.svg",
    "swap": "assets/icons/swap.svg",
    "gpu": "assets/icons/gpu.svg",
    "netDown": "assets/icons/netDown.svg",
    "netUp": "assets/icons/netUp.svg",
    "disk": "assets/icons/disk.svg",
    "battery": "assets/icons/battery.svg",
    "fan": "assets/icons/fan.svg",
    "clock": "assets/icons/clock.svg",
    "process": "assets/icons/process.svg",
    "service": "assets/icons/service.svg",
    "settings": "assets/icons/settings.svg",
    "ai": "assets/icons/ai.svg",
    "weather": "assets/icons/weather.svg"
  },
  "art": {
    "disk": "assets/city_glass_skyline.svg",
    "weather": "assets/faith_crouch_night.svg"
  },
  "footer": {
    "mark": "assets/me_runner_badge.svg",
    "label": "MIRROR'S EDGE",
    "motto": "FASTER  /  HIGHER  /  STRONGER"
  },
  "variants": {
