{
  "id": "adventure-time-candy-kingdom",
  "name": "Adventure Time (Candy Kingdom Control Panel)",
  "author": "Shani",
  "version": "2.1.0",
  "description": "A pastel candy-box control panel: wavy ink borders, wrapped sweets along the frame, a bubbly marquee, an eight-core candy-brain matrix, a little console robot on the GPU card and a waving kid under a smiling sun.",
  "fontFamily": "Architects Daughter, Comic Neue, Chalkboard SE, Trebuchet MS, cursive, sans-serif",
  "fonts": [
    "assets/fonts/ArchitectsDaughter-Regular.ttf",
    "assets/fonts/ComicNeue-Regular.ttf",
    "assets/fonts/ComicNeue-Bold.ttf"
  ],
  "features": {
    "enableCrtScanlines": false,
    "enablePhosphorDecay": false,
    "enableCornerBrackets": false,
    "enableGlassBlur": false,
    "enableGrid": false,
    "enableBarrel": false,
    "enableCartoonOutlines": true
  },
  "geometry": {
    "cardShape": "rounded",
    "pillShape": "stadium",
    "gaugeShape": "segmented",
    "cornerRadius": 18,
    "borderStyle": "solid",
    "borderWidth": 2.5,
    "hasCornerBrackets": false,
    "hasDropShadow": true,
    "shadowType": "flat-2d",
    "shadowOffset": [
      4,
      4
    ],
    "shadowBlur": 0
  },
  "frame": {
    "style": "candy",
    "decorations": "assets/candy_frame_decorations.svg",
    "hudLeft": "assets/custom_hud_buttons.svg",
    "hudRight": "assets/custom_hud_buttons.svg",
    "plaqueTitle": "THE CANDY KINGDOM CONTROL PANEL",
    "plaqueSubtitle": "System Monitor of Ooo",
    "plaque": "#1A0826",
    "plaqueText": "#FFE14D",
    "plaqueSubtext": "#FFAAF4",
    "rim": "#B47AD6"
  },
  "sections": {
    "style": "card",
    "uppercase": true,
    "screws": false,
    "tints": {
      "cpu": "#4A2050",
      "gpu": "#2E2A5A",
      "weather": "#2A3A60"
    }
  },
  "controls": {
    "meter": "",
    "meterLabel": true,
    "graph": "line",
    "graphFill": true,
    "coreGraph": "multi",
    "coreColors": [
      "#FF6E6E",
      "#5AD67A",
      "#B48CFF",
      "#5AC8FA",
      "#FFB347",
      "#FF6EDC",
      "#7FE0C8",
      "#FFD034"
    ],
    "coreLabel": "CPU ",
    "thermometer": true
