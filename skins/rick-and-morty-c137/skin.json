{
  "id": "rick-and-morty-c137",
  "name": "Rick and Morty (Dimension C-137)",
  "author": "Shani",
  "version": "2.1.0",
  "description": "A garage-built interdimensional dashboard: riveted scrap plating dripping green ooze, twin spinning portals, an eight-trace core oscilloscope, a slime-filled VRAM tube and comic speech bubbles.",
  "fontFamily": "Comic Neue, Permanent Marker, Chalkboard SE, Trebuchet MS, cursive, sans-serif",
  "fonts": [
    "assets/fonts/ComicNeue-Regular.ttf",
    "assets/fonts/ComicNeue-Bold.ttf",
    "assets/fonts/PermanentMarker-Regular.ttf"
  ],
  "features": {
    "enableCrtScanlines": false,
    "enablePhosphorDecay": false,
    "enableCornerBrackets": false,
    "enableGlassBlur": false,
    "enableGrid": false,
    "enableBarrel": false,
    "enableCartoonOutlines": true,
    "enablePortalSpinners": true,
    "enableSlimeDrips": true
  },
  "geometry": {
    "cardShape": "rounded",
    "pillShape": "stadium",
    "gaugeShape": "segmented",
    "cornerRadius": 16,
    "borderStyle": "solid",
    "borderWidth": 2.5,
    "hasCornerBrackets": false,
    "hasDropShadow": true,
    "shadowType": "flat-2d",
    "shadowOffset": [
      4,
      4
    ],
    "shadowBlur": 0
  },
  "frame": {
    "style": "scrap",
    "portal": "assets/portal_swirl.svg",
    "toolbelt": "assets/scrap_toolbelt.svg",
    "plaqueTitle": "INTERDIMENSIONAL SYSTEM DASHBOARD",
    "plaqueSubtitle": "Made of cobbled-together technology, green ooze, alien materials, glowing runes and makeshift wires.",
    "plaque": "#1A2228",
    "plaqueText": "#99FF33",
    "plaqueSubtext": "#00FFCC",
    "slime": "#00FF44",
    "rivets": "#8A96A0"
  },
  "sections": {
    "style": "card",
    "uppercase": true,
    "screws": true,
    "tints": {
      "cpu": "#2A1828",
      "gpu": "#1C2A1E",
      "weather": "#12242D"
    }
  },
  "controls": {
    "meter": "slime",
    "meterLabel": true,
    "graph": "taskmgr",
    "graphFill": false,
    "coreGraph": "multi",
    "coreColors": [
      "#99FF33",
      "#FF00AA",
      "#00FFFF",
      "#FFAA00",
      "#FF6600",
      "#AA00FF",
      "#33FF99",
      "#FF2244"
    ],
    "coreLabel": "UNIT R-",
    "thermometer": true
  },
  "icons": {
    "app": "assets/icons/app.svg",
    "cpu": "assets/icons/cpu.svg",
    "ram": "assets/icons/ram.svg",
    "swap": "assets/icons/swap.svg",
    "gpu": "assets/icons/gpu.svg",
    "netDown": "assets/icons/netDown.svg",
    "netUp": "assets/icons/netUp.svg",
    "disk": "assets/icons/disk.svg",
