  "roamers": [
    {
      "name": "Finn",
      "frames": [
        "assets/finn_walk_01.svg",
        "assets/finn_walk_02.svg"
      ],
      "width": 22,
      "height": 33,
      "stride": 7
    },
    {
      "name": "Jake",
      "frames": [
        "assets/jake_walk_01.svg",
        "assets/jake_walk_02.svg"
      ],
      "width": 31,
      "height": 22,
      "follow": 6,
      "stride": 6,
      "bob": true,
      "stretch": true,
      "notes": true,
      "waves": true
    }
  ],
  "faces": {
    "idle": "assets/bmo_face_idle.svg",
    "happy": "assets/bmo_face_happy.svg",
    "stressed": "assets/bmo_face_stressed.svg"
  },
  "clockQuips": {
    "nominal": "WHAT TIME IS IT? SYSTEM INTEGRITY TIME!",
    "stress": "HOT DOG WATER! HIGH COMPUTE LOAD DETECTED!"
  },
  "aiQuip": "BMO BRAIN PROCESSING ALGEBRAIC THOUGHTS!",
  "badgeColor": "#FF3B4A",
  "badgeTextColor": "#FFE14D",
  "badgeText": "ALGEBRAIC!"
