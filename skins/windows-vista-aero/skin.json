{
  "id": "windows-vista-aero",
  "name": "Windows Vista (Aero Glass)",
  "author": "Shani",
  "version": "2.1.0",
  "description": "Frutiger Aero: translucent teal glass with a curved specular sheen, glossy green and icy-blue meters, a glass pearl and Westminster at aurora dusk or meadow daylight.",
  "fontFamily": "'Segoe UI', 'Selawik', Tahoma, Arial, sans-serif",
  "features": {
    "enableCrtScanlines": false,
    "enablePhosphorDecay": false,
    "enableCornerBrackets": false,
    "enableGlassBlur": true,
    "enableGrid": false
  },
  "geometry": {
    "cardShape": "rounded",
    "pillShape": "stadium",
    "gaugeShape": "stadium",
    "cornerRadius": 14,
    "borderStyle": "solid",
    "borderWidth": 1.5,
    "hasCornerBrackets": false,
    "hasDropShadow": true,
    "shadowType": "soft",
    "shadowOffset": [
      0,
      8
    ],
    "shadowBlur": 22
  },
  "chrome": {
    "style": "aero",
    "buttons": "aero",
    "titleAlign": "left",
    "topRadius": 10,
    "bottomRadius": 10,
    "frameWidth": 4,
    "logo": "assets/vista_glass_orb.svg"
  },
  "sections": {
    "style": "card",
    "numbered": true,
    "uppercase": false,
    "toggle": "glass",
    "gloss": 0.4,
    "titleSize": 11
  },
  "controls": {
    "meter": "bevel",
    "graph": "line",
    "graphFill": true,
    "meterColors": {
